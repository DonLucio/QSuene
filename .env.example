PARTY_ENV=production
PARTY_DJ_ABSENCE_SECONDS=60
PARTY_SECRET_KEY=generate-at-least-64-random-characters
PARTY_PUBLIC_URL=https://qsuene.com
# La app DJ se sirve localmente mediante pywebview en el puerto 5001.
PARTY_ALLOWED_ORIGINS=https://qsuene.com,https://www.qsuene.com,http://127.0.0.1:5001
POSTGRES_DB=party
POSTGRES_USER=qsuene
POSTGRES_PASSWORD=replace-with-a-long-random-password
PARTY_DATABASE_URL=postgresql://qsuene:replace-with-a-long-random-password@postgres:5432/party
PARTY_REDIS_URL=redis://redis:6379/0
PARTY_ROOM_IDLE_MINUTES=120
PARTY_DISCONNECTED_GUEST_MINUTES=30
# API key de solo lectura. No agregar el shared secret al servidor.
PARTY_LASTFM_API_KEY=replace-with-lastfm-api-key
PARTY_LASTFM_TIMEOUT_SECONDS=4
PARTY_DISCOVERY_CACHE_SECONDS=1800
PARTY_DISCOVERY_REQUESTS_PER_MINUTE=12
