[Unit]
Description=Q'Suene Party API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=quesuene
Group=quesuene
WorkingDirectory=/opt/qsuene/platform/backend
EnvironmentFile=/etc/que-suene/party.env
ExecStart=/opt/qsuene/venv/bin/uvicorn party_server.main:application --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/que-suene

[Install]
WantedBy=multi-user.target
